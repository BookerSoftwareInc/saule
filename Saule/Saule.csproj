<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Approach B (see repo-root Standard-2.0-Migration-Plan.md, Section 4/7.1):
         net47          = classic System.Web.Http/System.Net.Http.Formatting Web API 2 pipeline
                           (today's consumers: CRM, BookerMain x3 - unchanged).
         net10.0        = ASP.NET Core MVC re-implementation of the same pipeline (custom
                           TextOutputFormatter/TextInputFormatter, MVC filters, middleware, DI
                           registration) under Http/NetCore/ - same class/method names as net47
                           where the design doc calls for it, built against a different base class.
         netstandard2.0 = portable core only (serialization/query engine, ApiResource,
                           IApiResourceProvider); the Web API 2-specific wiring has no
                           netstandard2.0 build available (System.Web.Http was never ported) and no
                           portable host would consume it anyway. -->
    <TargetFrameworks>netstandard2.0;net47;net10.0</TargetFrameworks>
    <AssemblyName>Saule</AssemblyName>
    <RootNamespace>Saule</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors Condition="'$(Configuration)'=='Release'">true</TreatWarningsAsErrors>
    <!-- Newtonsoft.Json 12.0.1 has a known high-severity advisory (NU1903, GHSA-5crp-9r3c-p9vr) -
         pre-existing on this branch already, not touched by this migration (bumping it is an
         independent decision with its own consumer-compatibility check, same as the
         Booker.ApplicationInsights migration's 12.0.1->13.0.3 bump - out of this session's decided
         scope). Suppressed here only so Release builds aren't blocked by a pre-existing finding;
         flagged as a follow-up action item, not silently fixed. NU1900 (failure to reach the internal
         feed's vulnerability-data endpoint) is suppressed alongside it - it's about feed availability
         in the current environment, not an actual finding about this code, and is intermittent. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903;NU1900</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- HttpRequestMessage.Properties is obsolete on net10.0 (superseded by .Options) but kept
         deliberately: it's the one shared per-request bag ResourceDescriptor/DefaultApiResourceProviderFactory
         use identically across all 3 TFMs (Standard-2.0-Migration-Plan.md Section 7.1) - switching to
         .Options on net10.0 only would fork behavior for no benefit, since Properties still works. -->
    <!-- JsonApiException's legacy ISerializable/SecurityPermissionAttribute serialization
         constructor pattern (portable file, unchanged from upstream Saule) is obsolete on net10.0
         (Code Access Security / formatter-based serialization no longer supported) but kept as-is,
         same reasoning as CS0618 above - it's shared, working code, not touched by this migration. -->
    <NoWarn Condition="'$(TargetFramework)'=='net10.0'">$(NoWarn);CS0618;CS0672;SYSLIB0003;SYSLIB0051</NoWarn>

    <!-- Package metadata (moved off the standalone Saule.nuspec/packages.config/appveyor.yml so a
         multi-TFM `dotnet pack` ships all three lib folders and declares the real per-TFM
         dependency set - same rationale as Booker.Core.Infrastructure.Libraries.WebApi.csproj and
         Booker.ApplicationInsights.Core.WebApi.csproj). -->
    <PackageId>Booker.Saule</PackageId>
    <Title>Saule for Json Api</Title>
    <Authors>Jouke van der Maas</Authors>
    <Owners>Jouke van der Maas</Owners>
    <Company>MINDBODY</Company>
    <Description>Json api library for ASP.Net Web API 2 (net47), ASP.NET Core (net10.0), and a portable serialization/query core (netstandard2.0). Custom package based on the original Saule.</Description>
    <PackageTags>web api serialization media formatter json api jsonapi ember data</PackageTags>
    <PackageReleaseNotes>Multi-targeted netstandard2.0;net47;net10.0. net47 keeps the System.Web.Http pipeline byte-identical; net10.0 adds an ASP.NET Core MVC re-implementation of the same pipeline (same class/method names); netstandard2.0 ships the portable serialization/query core only.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- Restored 2026-09-09 (PR review) - the old Saule.nuspec had projectUrl/licenseUrl/copyright,
         all silently dropped when it was removed for the SDK-style conversion. PackageLicenseExpression
         is the modern replacement for the deprecated licenseUrl (repo's own LICENSE file confirms MIT). -->
    <PackageProjectUrl>https://github.com/joukevandermaas/saule/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright 2015</Copyright>

    <!-- Version: bumped to 2.0.0 for the multi-target restructuring, consistent with how
         Booker.ApplicationInsights and Booker.Core.Infrastructure.Libraries.WebApi both bumped
         their major version when they added multi-targeting. net47 public surface/behavior is
         unchanged; the version bump signals the structural/packaging change (new TFMs added). -->
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- Surfaces the built assembly version to the Azure DevOps pipeline (azure-pipeline.yml's
       SetVersion step reads $(assemblyVersion)) - same mechanism as the sibling repos. Gated to
       $(TF_BUILD) (an env var Azure Pipelines itself sets, absent everywhere else) per PR review -
       this used to emit an Azure Pipelines logging command unconditionally, including for local
       builds and consumer builds that merely reference this project, which is meaningless noise
       outside actual CI. -->
  <Target Name="RetrieveAssemblyVersion" AfterTargets="Build" Condition="'$(TF_BUILD)' == 'true'">
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="Assembly" />
    </GetAssemblyIdentity>
    <Message Condition="%(Assembly.Version) != ''" Text="##vso[task.setvariable variable=assemblyVersion]%(Assembly.Version)" Importance="high" />
  </Target>

  <!-- No AssemblyInfo.cs / GenerateAssemblyInfo=false - matches the Booker.ApplicationInsights.Core.WebApi.csproj
       and Booker.Core.Infrastructure.Libraries.WebApi.csproj precedent: rely on the SDK's default
       assembly-info generation from the <Version>/<AssemblyVersion>/<FileVersion>/<Company>/<Title>
       properties above, plus the <InternalsVisibleTo> items below (same mechanism both sibling
       projects use for their own Tests/SmokeTests projects). ComVisible/Guid (COM-interop, no COM
       scenario applies here) are still dropped; CLSCompliant is restored, conditionally, in
       Properties/AssemblyInfo.CLSCompliant.cs per PR review. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
    <InternalsVisibleTo Include="Tests.NetCore.SmokeTests" />
  </ItemGroup>

  <!-- Portable core dependency - available on all 3 TFMs. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
    <PackageReference Include="Humanizer.Core" Version="2.6.2" />
  </ItemGroup>

  <!-- net47: classic ASP.NET Web API 2. Core = System.Web.Http.dll (filters/formatters/attributes);
       Client = System.Net.Http.Formatting.dll (MediaTypeFormatter/ObjectContent). Both net45-only -
       Microsoft.AspNet.WebApi.Client's netstandard2.0 asset is missing members the net47 pipeline
       needs (e.g. HttpRequestMessage.GetQueryNameValuePairs() - confirmed by an actual CS1061 build
       failure), so it stays net47-only; the portable core uses its own Uri-based query parser
       (UriExtensions.cs) instead of depending on this package at all. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net47'">
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.2.7" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.7" />
  </ItemGroup>

  <!-- net10.0: ASP.NET Core MVC abstractions come from the shared framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Exclude the classic Web API 2 pipeline (net47-only - see Standard-2.0-Migration-Plan.md
       Section 3.2/7.1: System.Web.Http has no netstandard2.0/net10.0 build) from the other two
       TFMs. net10.0 gets its own re-implementation of this pipeline under Http/NetCore/ instead
       (JsonApiProcessor's logic is folded into the new formatter/middleware rather than 1:1
       twinned - see Section 3.2 correction #3). -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net47'">
    <Compile Remove="Http\AllowsQueryAttribute.cs" />
    <Compile Remove="Http\DisableDefaultIncludedAttribute.cs" />
    <Compile Remove="Http\HandlesQueryAttribute.cs" />
    <Compile Remove="Http\HttpConfigExtensions.cs" />
    <Compile Remove="Http\JsonApiAttribute.cs" />
    <Compile Remove="Http\JsonApiMediaTypeFormatter.cs" />
    <Compile Remove="Http\JsonApiProcessor.cs" />
    <Compile Remove="Http\JsonApiQueryValueProvider.cs" />
    <Compile Remove="Http\JsonApiQueryValueProviderFactory.cs" />
    <Compile Remove="Http\PaginatedAttribute.cs" />
    <Compile Remove="Http\PreprocessingDelegatingHandler.cs" />
    <Compile Remove="Http\QueryContextUtils.cs" />
    <Compile Remove="Http\ReturnsResourceAttribute.cs" />
  </ItemGroup>

  <!-- The net10.0 ASP.NET Core re-implementation of the pipeline above - only compiled for net10.0. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="Http\NetCore\**\*.cs" />
  </ItemGroup>

</Project>
