<?xml version="1.0"?>
<package >
  <metadata>
    <id>Booker.Saule</id>
    <version>$version$</version>
    <title>Saule for Json Api</title>
    <authors>Jouke van der Maas</authors>
    <owners>Jouke van der Maas</owners>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/joukevandermaas/saule/</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Json api library for ASP.Net Web API 2. This is custom package for MyGet based on original Saule</description>
    <releaseNotes>Initial release</releaseNotes>
    <copyright>Copyright 2015</copyright>
    <tags>web api serialization media formatter json api jsonapi ember data</tags>
  </metadata>
  <dependencies>
    <group targetFramework=".NETFramework4.7">
      <dependency id="Humanizer.Core" version="2.6.2" />
      <dependency id="Microsoft.AspNet.WebApi.Core" version="5.2.7" />
      <dependency id="Newtonsoft.Json" version="12.0.1" />
  </group>
  </dependencies>
</package>
