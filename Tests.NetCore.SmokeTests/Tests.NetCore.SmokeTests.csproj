<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Permanent home for the real functional smoke test that verified the net10.0 ASP.NET Core
         pipeline (Standard-2.0-Migration-Plan.md Section 9/10, Action item 13) - a throwaway
         console app during that session, promoted here so net10.0 regressions are caught by CI
         going forward, same precedent as Booker.Core.Infrastructure.Libraries.WebApi.SmokeTests. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Saule\Saule.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
